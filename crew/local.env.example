# Machine-specific crew settings. Copy to crew/local.env (not in git) and edit.
# Sourced by scripts/crew-lib.sh.

# Usage gateway for qwen; only crews that list qwen need it (OpenAI-compatible proxy that
# records usage per X-TF-Profile/X-TF-Project).
#CREW_GATEWAY=http://127.0.0.1:8741
# Ledger root: <root>/<ledger>/runs.jsonl and <root>/<ledger>/ledger/usage.sqlite3 (ledger names: crews.tsv).
#CREW_USAGE_ROOT=$HOME/.local/share/usage/profiles
# Per-account OpenCode data/state for the qwen worker.
#CREW_OPENCODE_ROOT=$HOME/.local/share/usage/opencode-crew

# Optional budget-checked reviewer for accounts whose crews.tsv lists "litellm".
# Called as: $CREW_REVIEW_CMD <review|status> $CREW_REVIEW_ARGS --data-dir <ledger> [--model M --max-tokens N --project P --input FILE]
#CREW_REVIEW_CMD="python3 $HOME/path/to/reviewer.py"
#CREW_REVIEW_ARGS="--scope example"

# Optional usage report command for the coordinator: $CREW_REPORT_CMD --profile <ledger> --days 7
#CREW_REPORT_CMD="python3 $HOME/path/to/report.py"

# Optional qwen tuning. These settings have no effect unless crews.tsv lists qwen.
# Large local models plus their context cache can exhaust RAM. Start conservatively.
# LM Studio defaults to 128K context when enabled; reduce it for your machine.
#CREW_QWEN_CTX=65536
#CREW_QWEN_BACKEND=lmstudio
#CREW_QWEN_MODEL=lmstudio/qwen36-mlx
#CREW_LMSTUDIO_SOURCE=qwen/qwen3.6-35b-a3b
#CREW_QWEN_FORCE=1  # bypass brief-size limits for a deliberately chosen task

# qwen on LM Studio on another machine (CREW_QWEN_BACKEND=remote): an ssh alias with key auth.
# crew-up opens an ssh tunnel to its LM Studio (port 1234) on 127.0.0.1:<tunnel port> and loads
# the model there. The gateway's config.json needs "lmstudio_remote_url": "http://127.0.0.1:<tunnel port>".
# Defaults suit a 16 GB Mac: qwen/qwen3-8b at 32K context. Applies to every account on this machine.
#CREW_QWEN_BACKEND=remote
#CREW_LMSTUDIO_SSH=little-mac
#CREW_LMSTUDIO_TUNNEL_PORT=12340
#CREW_QWEN_MODEL=lmstudio-remote/qwen3-8b
#CREW_LMSTUDIO_SOURCE=qwen/qwen3-8b
#CREW_QWEN_CTX=32768
